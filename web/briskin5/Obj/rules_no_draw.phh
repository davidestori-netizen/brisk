require_once("briskin5.phh");
require_once("rules_base.phh");

class Rules_no_draw extends Rules_old_rules {
    function __construct($table)
    {
        parent::__construct($table);
        $this->id = 2;
    }

    static function game_result($asta_pnt, $pnt)
    {
        if ($pnt >= $asta_pnt)
            return (1);
        else
            return (-1);
    }

} // class Rules_no_draw

?>